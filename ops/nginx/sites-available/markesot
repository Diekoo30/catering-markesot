map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    http http;
    https https;
}

map $forwarded_proto $forwarded_port {
    default $server_port;
    https 443;
}

server {
    listen 80;
    listen [::]:80;
    server_name markesot.my.id www.markesot.my.id;

    include snippets/markesot-acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name jenkins.markesot.my.id grafana.markesot.my.id prometheus.markesot.my.id;

    include snippets/markesot-acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name markesot.my.id www.markesot.my.id;

    include snippets/markesot-ssl.conf;
    client_max_body_size 100M;
    include snippets/markesot-security-headers.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/markesot-proxy-common.conf;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jenkins.markesot.my.id;

    include snippets/markesot-ssl.conf;
    client_max_body_size 100M;
    include snippets/markesot-security-headers.conf;

    location / {
        proxy_pass http://127.0.0.1:8081;
        include snippets/markesot-proxy-common.conf;
        include snippets/markesot-proxy-websocket.conf;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name grafana.markesot.my.id;

    include snippets/markesot-ssl.conf;
    client_max_body_size 25M;
    include snippets/markesot-security-headers.conf;

    location / {
        proxy_pass http://127.0.0.1:3000;
        include snippets/markesot-proxy-common.conf;
        include snippets/markesot-proxy-websocket.conf;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name prometheus.markesot.my.id;

    include snippets/markesot-ssl.conf;
    client_max_body_size 10M;
    include snippets/markesot-security-headers.conf;

    location / {
        auth_basic "Prometheus";
        auth_basic_user_file /etc/nginx/.htpasswd-prometheus;

        proxy_pass http://127.0.0.1:9090;
        include snippets/markesot-proxy-common.conf;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
